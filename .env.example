# ===========================================================================
# Smart Waste Management System - Backend Configuration (.env)
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. MongoDB Database Backend Configuration
# ---------------------------------------------------------------------------
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/waste_management_system
#
# MongoDB Atlas Cloud Cluster Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/waste_management_system?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# 2. Gmail / SMTP Dispatch Configuration (Work Order Emails)
# ---------------------------------------------------------------------------
# The admin Gmail address that sends work orders to workers
GMAIL_USER=admin@smartwms.gov

# Gmail App Password (16-character code created at https://myaccount.google.com/apppasswords)
# Note: Requires 2-Step Verification enabled on the Google Account.
# You can paste it with or without spaces (e.g. abcd efgh ijkl mnop).
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional display name for the municipal administrator
ADMIN_NAME=Municipal Chief Administrator

# Optional SMTP host & port (Defaults to Gmail service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ---------------------------------------------------------------------------
# 3. Server Configuration
# ---------------------------------------------------------------------------
PORT=3000
